# Modèle de configuration. Lancez `bash scripts/gen_secrets.sh` pour créer .env automatiquement.
# .env contient des secrets : il est dans .gitignore et ne doit JAMAIS être commité.
DB_NAME=secureauth
DB_USER=secureauth_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
# Clés de 32 octets (256 bits) encodées en base64 : openssl rand -base64 32
ENCRYPTION_KEY=
HMAC_KEY=
